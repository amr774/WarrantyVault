generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum PlanCode {
  FREE
  PREMIUM
}

enum UserRole {
  USER
  OWNER
}
enum DeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  passwordHash String
  role UserRole @default(USER)
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  products Product[]
  notifications Notification[]
  reminderPreference ReminderPreference?
  subscription UserSubscription?
}
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  tokenHash String @unique
  familyId String @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([familyId])
}
model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}
model EmailVerificationToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}
model Category {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  products Product[]
}
model Product {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  categoryId String @db.Uuid
  category Category @relation(fields:[categoryId],references:[id])
  name String
  brand String @default("")
  model String @default("")
  serialNumber String?
  purchaseDate DateTime @db.Date
  purchasePrice Decimal? @db.Decimal(12,2)
  currency String @default("USD") @db.VarChar(3)
  storeName String?
  warrantyMonths Int
  warrantyStartDate DateTime? @db.Date
  expiresAt DateTime @db.Date
  expirationOverride Boolean @default(false)
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  receipts Receipt[]
  deliveries ReminderDelivery[]
  @@index([userId,expiresAt])
  @@index([userId,createdAt])
}
model Receipt {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  storageKey String @unique
  name String
  mimeType String
  size Int
  kind String @default("RECEIPT")
  createdAt DateTime @default(now())
  @@index([productId])
}
// Transactional cleanup queue: database deletes commit before removing file bytes.
model PendingFileDeletion {
  storageKey String @id
  createdAt DateTime @default(now())
  attempts Int @default(0)
}
model ReminderPreference {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  emailEnabled Boolean @default(true)
  inAppEnabled Boolean @default(true)
  days Int[] @default([30,7,1])
  updatedAt DateTime @updatedAt
}
model ReminderDelivery {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  expirationDate DateTime @db.Date
  daysBefore Int
  status DeliveryStatus @default(PENDING)
  attempts Int @default(0)
  lastError String?
  nextAttemptAt DateTime @default(now())
  sentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notification Notification?
  @@unique([productId,expirationDate,daysBefore])
  @@index([status,nextAttemptAt])
}
model Notification {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  deliveryId String? @unique @db.Uuid
  delivery ReminderDelivery? @relation(fields:[deliveryId],references:[id],onDelete:SetNull)
  title String
  message String
  productId String?
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId,createdAt])
}
model SubscriptionPlan {
  id String @id @default(uuid()) @db.Uuid
  code PlanCode @unique
  name String
  productLimit Int
  storageBytes BigInt
  subscriptions UserSubscription[]
}
model UserSubscription {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  planId String @db.Uuid
  plan SubscriptionPlan @relation(fields:[planId],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
